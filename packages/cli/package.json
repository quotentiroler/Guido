{
  "name": "@quotentiroler/guido-cli",
  "version": "1.2.2",
  "description": "CLI tools for Guido template validation and schema conversion",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "guido-validate-template": "./dist/validateTemplate.js",
    "guido-validate-settings": "./dist/validateSettings.js",
    "guido-apply-rules": "./dist/applyRules.js",
    "guido-schema-to-guido": "./dist/schemaToGuido.js",
    "guido-to-schema": "./dist/guidoToSchema.js"
  },
  "exports": {
    ".": {
      "@quotentiroler/guido-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validateTemplate": {
      "@quotentiroler/guido-source": "./src/validateTemplate.ts",
      "types": "./dist/validateTemplate.d.ts",
      "default": "./dist/validateTemplate.js"
    },
    "./validateSettings": {
      "@quotentiroler/guido-source": "./src/validateSettings.ts",
      "types": "./dist/validateSettings.d.ts",
      "default": "./dist/validateSettings.js"
    },
    "./applyRules": {
      "@quotentiroler/guido-source": "./src/applyRules.ts",
      "types": "./dist/applyRules.d.ts",
      "default": "./dist/applyRules.js"
    },
    "./schemaToGuido": {
      "@quotentiroler/guido-source": "./src/schemaToGuido.ts",
      "types": "./dist/schemaToGuido.d.ts",
      "default": "./dist/schemaToGuido.js"
    },
    "./guidoToSchema": {
      "@quotentiroler/guido-source": "./src/guidoToSchema.ts",
      "types": "./dist/guidoToSchema.d.ts",
      "default": "./dist/guidoToSchema.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "validate-template": "node dist/validateTemplate.js",
    "validate-settings": "node dist/validateSettings.js",
    "apply-rules": "node dist/applyRules.js",
    "schema-to-guido": "node dist/schemaToGuido.js",
    "guido-to-schema": "node dist/guidoToSchema.js"
  },
  "keywords": [
    "guido",
    "cli",
    "json-schema",
    "configuration",
    "validation"
  ],
  "author": "Maximilian Nussbaumer",
  "dependencies": {
    "@quotentiroler/guido-core": "^1.3.0",
    "@quotentiroler/guido-types": "^1.1.0",
    "js-yaml": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quotentiroler/Guido.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "homepage": "https://quotentiroler.github.io/Guido/",
  "files": [
    "dist"
  ]
}
