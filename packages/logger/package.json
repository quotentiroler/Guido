{
  "name": "@quotentiroler/guido-logger",
  "version": "1.0.1",
  "description": "Logging utilities for Guido packages",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "keywords": [
    "guido",
    "logger",
    "logging"
  ],
  "author": "Maximilian Nussbaumer",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quotentiroler/Guido.git",
    "directory": "packages/logger"
  },
  "homepage": "https://quotentiroler.github.io/Guido/",
  "files": [
    "dist"
  ]
}
