{
  "name": "@guido/mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for Guido template management - CRUD operations for fields and rules",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./definitions": "./dist/exports.js"
  },
  "bin": {
    "guido-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "guido",
    "settings",
    "configuration"
  ],
  "author": "Maximilian Nussbaumer",
  "license": "MIT",
  "dependencies": {
    "@guido/core": "^1.0.0",
    "@guido/types": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "js-yaml": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
