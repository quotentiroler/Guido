{
  "name": "@quotentiroler/guido-mcp-server",
  "version": "1.3.0",
  "description": "MCP Server for Guido template management - CRUD operations for fields and rules",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "@quotentiroler/guido-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./definitions": {
      "@quotentiroler/guido-source": "./src/exports.ts",
      "types": "./dist/exports.d.ts",
      "default": "./dist/exports.js"
    },
    "./store": {
      "@quotentiroler/guido-source": "./src/store/index.ts",
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./store/types": {
      "@quotentiroler/guido-source": "./src/store/types.ts",
      "types": "./dist/store/types.d.ts",
      "default": "./dist/store/types.js"
    },
    "./store/memory": {
      "@quotentiroler/guido-source": "./src/store/memory-store.ts",
      "types": "./dist/store/memory-store.d.ts",
      "default": "./dist/store/memory-store.js"
    },
    "./store/change-tracker": {
      "@quotentiroler/guido-source": "./src/store/change-tracker.ts",
      "types": "./dist/store/change-tracker.d.ts",
      "default": "./dist/store/change-tracker.js"
    },
    "./template-utils": {
      "@quotentiroler/guido-source": "./src/template-utils.ts",
      "types": "./dist/template-utils.d.ts",
      "default": "./dist/template-utils.js"
    }
  },
  "bin": {
    "guido-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "guido",
    "settings",
    "configuration"
  ],
  "author": "Maximilian Nussbaumer",
  "license": "MIT",
  "dependencies": {
    "@quotentiroler/guido-core": "^1.4.0",
    "@quotentiroler/guido-types": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "js-yaml": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quotentiroler/Guido.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://quotentiroler.github.io/Guido/",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "types": "./dist/index.d.ts"
}
