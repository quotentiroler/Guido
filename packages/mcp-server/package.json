{
  "name": "@quotentiroler/guido-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for Guido template management - CRUD operations for fields and rules",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./definitions": "./dist/exports.js"
  },
  "bin": {
    "guido-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "guido",
    "settings",
    "configuration"
  ],
  "author": "Maximilian Nussbaumer",
  "license": "MIT",
  "dependencies": {
    "@quotentiroler/guido-core": "^1.0.0",
    "@quotentiroler/guido-types": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "js-yaml": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quotentiroler/Guido.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://quotentiroler.github.io/Guido/",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
