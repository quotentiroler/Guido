{
  "name": "@quotentiroler/guido-mcp-server",
  "version": "1.1.1",
  "description": "MCP Server for Guido template management - CRUD operations for fields and rules",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./definitions": "./dist/exports.js",
    "./store": "./dist/store/index.js",
    "./store/types": "./dist/store/types.js",
    "./store/memory": "./dist/store/memory-store.js",
    "./store/change-tracker": "./dist/store/change-tracker.js",
    "./template-utils": "./dist/template-utils.js"
  },
  "bin": {
    "guido-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "guido",
    "settings",
    "configuration"
  ],
  "author": "Maximilian Nussbaumer",
  "license": "MIT",
  "dependencies": {
    "@quotentiroler/guido-core": "^1.0.0",
    "@quotentiroler/guido-types": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "js-yaml": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quotentiroler/Guido.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://quotentiroler.github.io/Guido/",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./definitions": { "types": "./dist/exports.d.ts", "default": "./dist/exports.js" },
      "./store": { "types": "./dist/store/index.d.ts", "default": "./dist/store/index.js" },
      "./store/types": { "types": "./dist/store/types.d.ts", "default": "./dist/store/types.js" },
      "./store/memory": { "types": "./dist/store/memory-store.d.ts", "default": "./dist/store/memory-store.js" },
      "./store/change-tracker": { "types": "./dist/store/change-tracker.d.ts", "default": "./dist/store/change-tracker.js" },
      "./template-utils": { "types": "./dist/template-utils.d.ts", "default": "./dist/template-utils.js" }
    }
  }
}
