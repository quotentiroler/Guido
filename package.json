{
  "name": "guido",
  "private": true,
  "version": "1.0.0-alpha",
  "type": "module",
  "description": "A visual configuration management tool for creating, editing, and validating application settings with intelligent rule-based automation",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "Apache-2.0",
  "author": "Maximilian Nussbaumer",
  "homepage": "https://quotentiroler.github.io/Guido/",
  "repository": {
    "type": "git",
    "url": "https://github.com/quotentiroler/Guido.git"
  },
  "bugs": {
    "url": "https://github.com/quotentiroler/Guido/issues"
  },
  "keywords": [
    "configuration",
    "config",
    "template",
    "settings",
    "rules",
    "validation",
    "json",
    "yaml",
    "editor",
    "mcp",
    "ai"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:packages && vite build",
    "build:ui": "vite build",
    "build:cli": "npm run build -w @quotentiroler/guido-cli",
    "build:mcp": "npm run build -w @quotentiroler/guido-mcp-server",
    "build:core": "npm run build -w @quotentiroler/guido-core",
    "build:types": "npm run build -w @quotentiroler/guido-types",
    "build:logger": "npm run build -w @quotentiroler/guido-logger",
    "build:packages": "npm run build:types && npm run build:logger && npm run build:core && npm run build:mcp && npm run build:cli && npm run verify:dist",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "validate": "npx tsx packages/cli/src/validateTemplate.ts",
    "schema-to-guido": "npx tsx packages/cli/src/schemaToGuido.ts",
    "guido-to-schema": "npx tsx packages/cli/src/guidoToSchema.ts",
    "generate:guido": "npx tsx packages/cli/src/schemaToGuido.ts public/registries/registry.schema.json -o public/templates/registry.guido.json --filename custom.registry.json",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@gera2ld/tarjs": "^0.3.1",
    "@quotentiroler/guido-cli": "^1.0.0",
    "@quotentiroler/guido-core": "^1.0.0",
    "@quotentiroler/guido-logger": "^1.0.0",
    "@quotentiroler/guido-mcp-server": "^1.0.0",
    "@quotentiroler/guido-types": "^1.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "ai": "^7.0.22",
    "classnames": "^2.5.1",
    "interweave": "^13.1.1",
    "js-yaml": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "localforage": "^1.10.0",
    "marked": "^18.0.6",
    "papaparse": "^5.5.4",
    "path": "^0.12.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@max-health-inc/config": "github:Max-Health-Inc/config#v3.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "^4.0.14",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.0.0",
    "postcss": "^8.5.17",
    "tailwindcss": "^4.1.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.0.13"
  }
}
